# Copy to .env.local and fill in. .env.local is gitignored.
#
# CONVEX_DEPLOYMENT, CONVEX_URL and CONVEX_SITE_URL are written automatically by
# `npx convex dev` — do not set them by hand.

# Lets `npm run deploy` push to production without an interactive prompt.
# Convex dashboard -> project -> Settings -> Deploy Keys -> Generate Production Deploy Key
CONVEX_DEPLOY_KEY=

# Keeps Convex codegen temp files on the same drive as the project.
# Windows only; the CLI warns without it when the project is not on C:.
CONVEX_TMPDIR=

# ─────────────────────────────────────────────────────────────────────────────
# The keys below are set as Convex environment variables on the deployment
# (dashboard -> Settings -> Environment Variables), not read from this file at
# runtime. They live here so a fresh clone knows what it needs.
# ─────────────────────────────────────────────────────────────────────────────

# Firecrawl — search, map, scrape, and /interact for the browser handover
FIRECRAWL_API_KEY=

# AgentMail — the agent's own inbox, threads, drafts, and the inbound webhook
AGENTMAIL_API_KEY=

# OpenRouter — routes to the OpenAI model. One file calls this: convex/agent/model.ts
OPENROUTER_API_KEY=
MODEL_ID=
